#!/bin/sh
# Pre-push hook - comprehensive checks before pushing to remote.
#
# `git push` is a deliberate human action, so MANUAL_RUN=1 is set to unlock the
# full e2e-frontend suite. Any unattended/agentic invocation of `make e2e-frontend`
# without MANUAL_RUN=1 refuses with a non-zero exit by design — see Makefile.

echo "🔍 Running pre-push validation..."

MANUAL_RUN=1 make ci-full

if [ $? -ne 0 ]; then
    echo "❌ Pre-push validation failed. Push aborted."
    echo "   Fix errors and try again, or use 'git push --no-verify' to skip."
    exit 1
fi

echo "✅ Pre-push validation passed"
exit 0
